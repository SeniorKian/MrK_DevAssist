# Normalize text files to LF in the repository and in every checkout, including
# Windows with core.autocrlf=true. Shell scripts and configs copied into the Linux
# image break on CRLF (`set -eu\r` fails), so they are forced to LF explicitly.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
