# /etc/devassist/devassist.env — environment of devassist.service (native install).
#
# The same values the container gets from deploy/appliance/Dockerfile (ENV) and
# deploy/appliance/compose.production.yaml. Paths are the paths INSIDE the
# service's mount namespace: /data is the data directory (default
# /var/lib/devassist on the host), exactly like the container.
# scripts/install-native.sh writes this file once and never overwrites it.
# After a change: sudo systemctl restart devassist
#
# Every MRK_* name is described in the panel (Settings -> All settings) and in
# apps/control-plane/src/mrk_control_plane/settings_registry_entries_*.py.

# --- Fixed by the appliance layout (do not change) --------------------------
MRK_ENV=production
MRK_DATA_DIR=/data
MRK_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
MRK_ADMIN_UI_DIR=/opt/mrk/admin-ui
MRK_PYPI_SERVER_DIR=/data/pypi/server
MRK_PYPI_BOOTSTRAP_STATE_FILE=/data/pypi/auth/upstream-configured
MRK_PYPI_UPSTREAM_URL=http://127.0.0.1:3142/simple/
MRK_PYPI_ROUTER_PORT=3142
MRK_PYPI_ROUTER_HEALTH_HOST=127.0.0.1

# --- Services ---------------------------------------------------------------
MRK_NPM_ENABLED=true
MRK_NPM_HEALTH_PORT=4873
MRK_PYPI_ENABLED=true
MRK_PYPI_HEALTH_PORT=3141
MRK_PYPI_PRIMARY_UPSTREAM=https://pypi.org/simple/
MRK_PYPI_FALLBACK_UPSTREAM=https://package-mirror.liara.ir/repository/pypi/simple/
MRK_PYPI_ROUTER_READ_TIMEOUT=90
MRK_PYPI_REQUEST_TIMEOUT=900
# Public PyPI URL for generated links (or set the PyPI domain in the panel).
# MRK_PYPI_OUTSIDE_URL=https://pypi.example.com

# --- Listeners --------------------------------------------------------------
# The container listens on 0.0.0.0 but Compose publishes only on 127.0.0.1.
# A native process has no port mapping, so the panel and S3 listen on loopback
# by default. Put a reverse proxy (TLS) in front, or change these and firewall
# the ports. Verdaccio (4873) and devpi (3141) always listen on 0.0.0.0: block
# them from the Internet in your host firewall (docs/install-native.md).
MRK_HOST=127.0.0.1
MRK_PORT=8080
MRK_S3_LISTEN=127.0.0.1:9000
# npm and PyPI registries: only this server can reach them (put a reverse proxy or a domain in front).
MRK_NPM_LISTEN_HOST=127.0.0.1
MRK_PYPI_LISTEN_HOST=127.0.0.1

# --- Web and sign-in --------------------------------------------------------
# Set these to your real HTTPS origin and host names before going public.
MRK_CORS_ORIGINS=http://localhost:8080
MRK_TRUSTED_HOSTS=localhost,127.0.0.1
# Addresses of your reverse proxy, so the audit log and rate limits see client IPs.
# MRK_TRUSTED_PROXIES=127.0.0.1
MRK_AUTH_COOKIE_SECURE=true
MRK_SESSION_TTL_SECONDS=28800
MRK_LOG_LEVEL=INFO

# --- Optional ---------------------------------------------------------------
# 32 random bytes that encrypt upstream credentials; kept outside the data dir.
# The file must be readable by the devassist user (e.g. /etc/devassist/upstream.key, 0640 root:devassist).
# MRK_UPSTREAM_SECRET_KEY_FILE=/etc/devassist/upstream.key
# Host Agent / firewall helper pairing from the environment (otherwise pair in the panel).
# MRK_AGENT_URL=http://127.0.0.1:7070
# MRK_AGENT_KEY_FILE=/etc/devassist/agent.key
# MRK_FIREWALL_URL=unix:/run/mrk-firewall/firewall.sock
# MRK_FIREWALL_KEY_FILE=/etc/devassist/firewall.key

# --- Build metadata (written by the installer) ------------------------------
MRK_BUILD_COMMIT=@DEVASSIST_COMMIT@
MRK_BUILD_DATE=@DEVASSIST_BUILD_DATE@
