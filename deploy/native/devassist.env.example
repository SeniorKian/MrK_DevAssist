# /etc/devassist/devassist.env — environment of devassist.service (native panel).
#
# The same values the panel image gets from deploy/images/Dockerfile (ENV) and
# compose.yaml. Paths are the paths INSIDE the service's mount namespace: /data
# is the data directory (default /var/lib/devassist on the host), like the image.
# scripts/install-native.sh writes this file once and keeps your changes; it
# only re-sets MRK_PANEL_RUNTIME, MRK_HOST_DATA_DIR, MRK_NPM_ENABLED, MRK_PYPI_ENABLED, MRK_BUILD_COMMIT and MRK_BUILD_DATE.
# After a change: sudo systemctl restart devassist
#
# Every MRK_* name is described in the panel (Settings -> All settings) and in
# apps/control-plane/src/mrk_control_plane/settings_registry_entries_*.py.

# --- Fixed by the panel layout (do not change) ------------------------------
MRK_ENV=production
MRK_DATA_DIR=/data
MRK_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
MRK_ADMIN_UI_DIR=/opt/mrk/admin-ui
# The add-service wizard reads this: Docker services publish their ports on
# 127.0.0.1 (agent :7070, S3 admin :9001) and bind-mount their socket dirs at
# /run/mrk-dns and /run/mrk-firewall instead of joining the panel's Docker network.
MRK_PANEL_RUNTIME=native
# Host path of the data directory (the wizard bind-mounts npm/ and pypi/ from it).
MRK_HOST_DATA_DIR=@DEVASSIST_DATA_DIR@
# Only the panel runs here; npm and PyPI are separate services.
MRK_NPM_ENABLED=false
MRK_PYPI_ENABLED=false

# --- Listener ---------------------------------------------------------------
# Loopback by default: put a reverse proxy (TLS) in front, or set 0.0.0.0 and
# firewall the port.
MRK_HOST=127.0.0.1
MRK_PORT=8080

# --- Web and sign-in --------------------------------------------------------
# Set these to your real HTTPS origin and host names before going public.
MRK_CORS_ORIGINS=http://localhost:8080
MRK_TRUSTED_HOSTS=localhost,127.0.0.1
# Addresses of your reverse proxy, so the audit log and rate limits see client IPs.
# MRK_TRUSTED_PROXIES=127.0.0.1
MRK_AUTH_COOKIE_SECURE=true
MRK_SESSION_TTL_SECONDS=28800
MRK_LOG_LEVEL=INFO

# --- Optional ---------------------------------------------------------------
# 32 random bytes that encrypt upstream credentials; kept outside the data dir.
# The file must be readable by the devassist user (e.g. /etc/devassist/upstream.key, 0640 root:devassist).
# MRK_UPSTREAM_SECRET_KEY_FILE=/etc/devassist/upstream.key
# Where the wizard points service images (default: this project's GHCR).
# MRK_IMAGE_REGISTRY=

# --- Build metadata (written by the installer) ------------------------------
MRK_BUILD_COMMIT=@DEVASSIST_COMMIT@
MRK_BUILD_DATE=@DEVASSIST_BUILD_DATE@
