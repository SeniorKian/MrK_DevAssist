# /etc/pishkar/agent.env — environment of pishkar-agent.service (mrk-agent).
# Same names as the `mrk-agent` service in compose.yaml.
# After a change: sudo systemctl restart pishkar-agent

MRK_LOG_LEVEL=INFO
# Loopback only: the panel runs on the same host. Pair with http://127.0.0.1:7070.
MRK_AGENT_LISTEN=127.0.0.1:7070
MRK_AGENT_STATE_DIR=/var/lib/mrk-agent
MRK_AGENT_DOCKER_SOCKET=/var/run/docker.sock
MRK_AGENT_HOST_PROC=/opt/mrk/agent-host/proc
MRK_AGENT_HOST_CGROUP=/opt/mrk/agent-host/cgroup
MRK_AGENT_HOST_VOLUMES=/opt/mrk/agent-host/volumes
MRK_AGENT_HOST_ROOT=/opt/mrk/agent-host/root
# Extra protected-container name regex (default protects Dokploy).
# MRK_AGENT_PROTECTED_NAME_REGEX=
# Opt-in (docs/35): folder where the agent may write ONLY mrk-domains.yml.
# Also add ReadWritePaths= for it (see pishkar-agent.service).
# MRK_AGENT_TRAEFIK_DYNAMIC_DIR=/etc/dokploy/traefik/dynamic
