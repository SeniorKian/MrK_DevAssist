# /etc/pishkar/dns.env — environment of pishkar-dns.service (the mrk-dns engine).
# Same names and defaults as the `mrk-dns` service in compose.yaml.
# After a change: sudo systemctl restart pishkar-dns

MRK_DNS_DATA_DIR=/var/lib/mrk-dns
MRK_DNS_ADMIN_SOCKET=/run/mrk-dns/admin.sock
MRK_DNS_ADMIN_TOKEN_FILE=/run/mrk-dns/admin.token
# First start only; afterwards the listen addresses come from the DNS settings in the panel.
# 172.17.0.1 is Docker's default bridge gateway (containers reach DNS there);
# the engine retries it every 10 s until docker0 exists.
MRK_DNS_LISTEN=127.0.0.1:53,172.17.0.1:53
# Go soft memory limit: about 85% of MemoryMax=512M in pishkar-dns.service.
MRK_DNS_GOMEMLIMIT=435MiB
MRK_DNS_LOG_LEVEL=info
