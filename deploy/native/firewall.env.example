# /etc/devassist/firewall.env — environment of devassist-firewall.service (mrk-firewall).
# Same names as the `mrk-firewall` service in compose.yaml.
# After a change: sudo systemctl restart devassist-firewall

MRK_LOG_LEVEL=INFO
MRK_FIREWALL_LISTEN=unix:/run/mrk-firewall/firewall.sock
MRK_FIREWALL_STATE_DIR=/var/lib/mrk-firewall
# /var/log is mounted read-only at <root>/system (see the unit file).
MRK_FIREWALL_LOG_ROOT=/opt/mrk/firewall-logroot
# true = never install rules, whatever the panel says (emergency brake).
MRK_FIREWALL_FORCE_DRY_RUN=false
