# Pishkar DNS engine (native install) — the `mrk-dns` Compose service (profile dns).
#
# Container: starts as uid 0 with NET_BIND_SERVICE+SETUID+SETGID and drops to
# MRK_DNS_RUN_AS. Native: systemd starts it directly as the unprivileged
# `pishkar` user with only CAP_NET_BIND_SERVICE (ambient), so the engine's
# own drop is a no-op (it only drops when started as root). The result is the
# same as in the container: uid pishkar, CapEff = NET_BIND_SERVICE only.
#
# Host network namespace (like network_mode: host). The admin socket and token
# live in /run/mrk-dns, which the panel (same user) reads.

[Unit]
Description=Pishkar DNS engine (mrk-dns)
Documentation=https://github.com/SeniorKian/MrK_DevAssist/blob/main/docs/install-native.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pishkar
Group=pishkar
UMask=0027
EnvironmentFile=/etc/pishkar/dns.env
ExecStart=/opt/mrk/bin/mrk-dns serve
Restart=always
RestartSec=3
TimeoutStopSec=15

StateDirectory=mrk-dns
StateDirectoryMode=0750
RuntimeDirectory=mrk-dns
RuntimeDirectoryMode=0750
# Keep the socket directory (and its token) across restarts of this unit.
RuntimeDirectoryPreserve=restart

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Same ceilings as compose (MRK_DNS_CPUS, MRK_DNS_MEMORY, MRK_DNS_PIDS).
CPUQuota=200%
MemoryMax=512M
MemorySwapMax=0
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
