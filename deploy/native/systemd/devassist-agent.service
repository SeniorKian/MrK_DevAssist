# DevAssist Host Agent (native install) — the `mrk-agent` Compose service.
#
# Like the container: root with only CAP_DAC_READ_SEARCH and CAP_DAC_OVERRIDE
# (server backups read Docker volumes), host mounts read-only, Docker socket
# access through the agent's in-code allowlist. SECURITY: Docker socket access
# is equivalent to root on the host.
#
# Native differences: it listens on 127.0.0.1:7070 (no private Compose network
# here), and the host views it expects (/host/proc, /host/cgroup, ...) are
# bind-mounted below /opt/mrk/agent-host. The agent's DNS checks require the
# host /proc at a path other than /proc, so /proc is mounted there too.

[Unit]
Description=DevAssist Host Agent (mrk-agent)
Documentation=https://github.com/SeniorKian/MrK_DevAssist/blob/main/docs/install-native.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/devassist/agent.env
Environment=PATH=/opt/mrk/venv/bin:/usr/bin:/bin
ExecStart=/opt/mrk/venv/bin/mrk-agent
Restart=always
RestartSec=3
TimeoutStopSec=15

StateDirectory=mrk-agent
StateDirectoryMode=0700

BindReadOnlyPaths=/proc:/opt/mrk/agent-host/proc /sys/fs/cgroup:/opt/mrk/agent-host/cgroup
# Docker volumes for server backups ("-": skipped when Docker is not installed).
BindReadOnlyPaths=-/var/lib/docker/volumes:/opt/mrk/agent-host/volumes
# Host root, read-only and non-recursive: only statvfs disk usage and the host name.
# Delete this line to hide the host filesystem from the agent.
BindReadOnlyPaths=/:/opt/mrk/agent-host/root:norbind
# Opt-in (docs/35, domains mode traefik_file): set MRK_AGENT_TRAEFIK_DYNAMIC_DIR
# in /etc/devassist/agent.env and allow writes with `systemctl edit devassist-agent`:
#   [Service]
#   ReadWritePaths=/etc/dokploy/traefik/dynamic

CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
TasksMax=128

[Install]
WantedBy=multi-user.target
