# DevAssist firewall helper (native install) — the `mrk-firewall` Compose service.
#
# Like the container: root with ONLY CAP_NET_ADMIN, host network namespace,
# read-only system and read-only logs. It manages only the nftables table
# `inet mrk`. No ports: Unix socket /run/mrk-firewall/firewall.sock; the
# directory is root:devassist 0750, so only the panel's user can reach it.
#
# Logs: the API path /host/log/system/... maps to MRK_FIREWALL_LOG_ROOT/system/...
# /var/log is bind-mounted read-only at /opt/mrk/firewall-logroot/system, so
# the panel default /host/log/system/auth.log works unchanged.

[Unit]
Description=DevAssist firewall helper (mrk-firewall)
Documentation=https://github.com/SeniorKian/MrK_DevAssist/blob/main/docs/install-native.md
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=devassist
# Ubuntu's rsyslog writes auth.log as syslog:adm 0640; without DAC capabilities
# root can read it only through the adm group.
SupplementaryGroups=adm
UMask=0077
EnvironmentFile=/etc/devassist/firewall.env
Environment=PATH=/opt/mrk/venv/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/mrk/venv/bin/mrk-firewall
Restart=always
RestartSec=3
TimeoutStopSec=15

StateDirectory=mrk-firewall
StateDirectoryMode=0700
RuntimeDirectory=mrk-firewall
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart

BindReadOnlyPaths=/var/log:/opt/mrk/firewall-logroot/system
# Optional Traefik (Dokploy) access log; add with `systemctl edit devassist-firewall`:
#   [Service]
#   BindReadOnlyPaths=/etc/dokploy/traefik/dynamic/access.log:/opt/mrk/firewall-logroot/traefik/access.log

CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=128M
MemorySwapMax=0
CPUQuota=25%
TasksMax=64

[Install]
WantedBy=multi-user.target
