# MrK DevAssist panel (native install, docs/install-native.md).
#
# The same process tree as the `panel` image (deploy/images/Dockerfile): supervisord
# with deploy/images/panel/supervisord.conf (control plane, PyPI router, fatal-exit
# listener). Every other service runs in Docker, added from the panel's wizard.
#
# The mount namespace recreates the paths the image uses, so the code and
# supervisord.conf run unchanged:
#   /data            <- the data directory (default /var/lib/devassist)
#   /usr/local/bin   <- /opt/mrk/bin (supervisord, mrk-* entry points)
#   /tmp             <- private tmpfs (noexec,nosuid,nodev), like the container
# @DEVASSIST_DATA_DIR@ is replaced by scripts/install-native.sh.

[Unit]
Description=MrK DevAssist panel
Documentation=https://github.com/SeniorKian/MrK_DevAssist/blob/main/docs/install-native.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devassist
Group=devassist
UMask=0027
EnvironmentFile=/etc/devassist/devassist.env
# venv first so `python` is the panel interpreter (supervisord.conf runs `python -m ...`).
Environment=PATH=/opt/mrk/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/tmp
# Same as the image ENV.
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ExecStart=/opt/mrk/venv/bin/python /opt/mrk/devassist_supervise.py
# supervisord stops its programs in reverse priority (see supervisord.conf).
# Only the main process gets SIGTERM.
KillMode=mixed
TimeoutStopSec=180
TimeoutStartSec=infinity
# The FATAL listener stops supervisord with status 0; restart on every exit.
Restart=always
RestartSec=5

# Paths the image provides (see the header).
BindPaths=@DEVASSIST_DATA_DIR@:/data
BindReadOnlyPaths=/opt/mrk/bin:/usr/local/bin
TemporaryFileSystem=/tmp:size=64m,mode=1777,noexec,nosuid,nodev
# Sockets of the Docker DNS and firewall services: /run/mrk-dns and /run/mrk-firewall
# (created by /etc/tmpfiles.d/devassist.conf, 2750 10001:devassist). ProtectSystem=strict
# leaves /run readable, and connecting to a Unix socket works on a read-only view,
# so no extra ReadWritePaths= is needed; a per-directory bind is deliberately not
# used, so a directory recreated by Docker after the panel started is still seen.
# Agent (127.0.0.1:7070) and S3 admin (127.0.0.1:9001) are reached over loopback.
# PostgreSQL: TCP to MRK_DATABASE_URL (local cluster 127.0.0.1:5432; AF_INET is allowed
# and there is no IPAddressDeny=). The password file /etc/devassist/db-password
# (0640 root:devassist) is read through the read-only /etc. The installer adds
# devassist.service.d/postgresql.conf (Wants/After=postgresql.service) for a local cluster.

# Hardening, mirroring the container: no capabilities, no-new-privileges,
# read-only system, resource ceilings.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Same ceilings as compose.yaml (MRK_MEM_LIMIT, MRK_CPUS, pids_limit, nofile).
MemoryMax=2G
MemorySwapMax=0
CPUQuota=100%
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
