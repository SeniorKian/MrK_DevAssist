# This file contains placeholders only. Copy it to .env for local development.
#
# ---------------------------------------------------------------------------
# 1) Values that compose.yaml reads (Compose interpolation only). Compose does
#    NOT pass the rest of this file into the container; the container's own
#    settings are written in compose.yaml and the image defaults.
# ---------------------------------------------------------------------------
# Optional production secret-file path containing exactly 32 raw random bytes.
# If configured, the appliance reads it but never creates or overwrites it.
MRK_UPSTREAM_SECRET_KEY_FILE=
# Leave unset to use the named volume "mrk-dev-data". To bind-mount instead, point
# this at a host directory that already exists and is owned by 10001:10001.
# MRK_HOST_DATA_PATH=/srv/mrk-data
# DNS engine data (zones, settings) on a host directory owned by 10001:10001
# instead of the named volume "mrk-dns-data".
# MRK_HOST_DNS_PATH=/opt/dnsconfig
# Only with compose.split-storage.yaml (all three required there): one host directory
# each for npm, PyPI and the S3 object store, owned by 10001:10001. Read the comments
# at the top of that file first; separate mounts limit the offline restore.
# MRK_HOST_NPM_PATH=/storage/npm
# MRK_HOST_PYPI_PATH=/storage/pypi
# MRK_HOST_S3_PATH=/storage/s3
# Host ports (bound to 127.0.0.1).
# Temporary direct access to the panel at http://<server-ip>:8080 (plain HTTP, no TLS:
# create the owner account right away and firewall the port): set MRK_ADMIN_BIND=0.0.0.0
# and add the server IP to MRK_TRUSTED_HOSTS in section 2 below. Prefer an SSH tunnel.
# MRK_ADMIN_BIND=0.0.0.0
MRK_ADMIN_PORT=8080
MRK_NPM_PORT=4873
MRK_PYPI_PORT=3141
# Container resource ceilings.
MRK_MEM_LIMIT=2g
MRK_CPUS=2.0
# Optional Host Agent (`docker compose --profile agent up -d`). Host docker group id,
# from `getent group docker | cut -d: -f3`, so the unprivileged agent can read the socket.
# MRK_DOCKER_GID=999
# Extra protected-container name regex (default protects Dokploy: ^/?dokploy([-._]|$)).
# MRK_AGENT_PROTECTED_NAME_REGEX=
# Pair from the environment instead of the Admin UI (both required; the key file must
# also be mounted into mrk-mirror). Leave commented to pair in Admin UI -> Host Agent.
# MRK_AGENT_URL=http://mrk-agent:7070
# MRK_AGENT_KEY_FILE=/run/secrets/mrk_agent_key
# Build-time package sources (optional). Empty uses the official hosts. Set them where
# those hosts are blocked or slow (for example on servers in Iran): uncomment one line
# per variable. Mirrors change; if one stops answering, try the next.
#
# npm (`npm ci`). Lockfile sha512 integrity hashes are still enforced on a mirror.
MRK_BUILD_NPM_REGISTRY=
# MRK_BUILD_NPM_REGISTRY=https://package-mirror.liara.ir/repository/npm/
# MRK_BUILD_NPM_REGISTRY=https://mirror-npm.runflare.com/
# MRK_BUILD_NPM_REGISTRY=https://registry.npmmirror.com/
#
# pip. pip does NOT verify hashes: a pip mirror must be trusted as much as PyPI itself.
MRK_BUILD_PIP_INDEX_URL=
# MRK_BUILD_PIP_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple/
# MRK_BUILD_PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple/
# MRK_BUILD_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
#
# Go modules. go.sum pins every module hash, so a proxy cannot change module contents.
# Needed where proxy.golang.org answers 403. Several proxies: separate them with |
# (the next one is tried on any error).
MRK_BUILD_GOPROXY=
# MRK_BUILD_GOPROXY=https://package-mirror.liara.ir/repository/go|https://goproxy.cn|direct
# MRK_BUILD_GOPROXY=https://mirror-go.runflare.com|https://goproxy.io|direct
# MRK_BUILD_GOPROXY=https://goproxy.cn|https://goproxy.io|direct
#
# Debian packages (the one apt step). Package lists stay signature-checked. Needed where
# deb.debian.org times out. The mirror must serve <url>/debian and <url>/debian-security.
MRK_BUILD_APT_MIRROR=
# MRK_BUILD_APT_MIRROR=https://mirror.arvancloud.ir
# MRK_BUILD_APT_MIRROR=https://repo.iut.ac.ir/repo

# ---------------------------------------------------------------------------
# 2) Process settings for running the control plane directly (outside Docker),
#    e.g. `set -a; . ./.env; set +a; mrk-control-plane`.
# ---------------------------------------------------------------------------
MRK_ENV=development
MRK_DATA_DIR=/data
# The image defaults to embedded loopback-only PGlite. Override only for external PostgreSQL:
# MRK_DATABASE_URL=postgresql+psycopg://mrk:change-me@postgres:5432/mrk?sslmode=require
MRK_LOG_LEVEL=INFO
MRK_CORS_ORIGINS=http://localhost:5173
MRK_TRUSTED_HOSTS=localhost,127.0.0.1
MRK_NPM_ENABLED=true
MRK_NPM_HEALTH_PORT=4873
MRK_PYPI_ENABLED=true
MRK_PYPI_HEALTH_PORT=3141
MRK_PYPI_BOOTSTRAP_STATE_FILE=/data/pypi/auth/upstream-configured
MRK_NPM_PRIMARY_UPSTREAM=https://registry.npmjs.org/
MRK_NPM_FALLBACK_UPSTREAM=https://package-mirror.liara.ir/repository/npm/
MRK_PYPI_ROUTER_MAX_ARTIFACT_BYTES=2147483648
MRK_PYPI_OUTSIDE_URL=https://pypi.example.com
MRK_PYPI_UPSTREAM_URL=http://127.0.0.1:3142/simple/
MRK_PYPI_PRIMARY_UPSTREAM=https://pypi.org/simple/
MRK_PYPI_FALLBACK_UPSTREAM=https://package-mirror.liara.ir/repository/pypi/simple/
MRK_PYPI_ROUTER_PORT=3142
MRK_PYPI_ROUTER_HEALTH_HOST=127.0.0.1
MRK_PYPI_ROUTER_READ_TIMEOUT=90
# devpi waits this long per read on the router, which spools and verifies a whole
# artifact before sending it. Clients fetching large artifacts need e.g. `pip --timeout 900`.
MRK_PYPI_REQUEST_TIMEOUT=900
MRK_PYPI_THREADS=16

MRK_AUTH_COOKIE_SECURE=true
MRK_SESSION_TTL_SECONDS=28800
# Only set this when the file really exists (for example a mounted Docker secret);
# devpi refuses to start if it is configured but missing or empty.
# MRK_PYPI_ROOT_PASSWORD_FILE=/run/secrets/devpi_root_password

# Public origins used to generate client-facing links.
MRK_ADMIN_ORIGIN=http://localhost:8080
MRK_NPM_ORIGIN=http://localhost:4873
MRK_PYPI_ORIGIN=http://localhost:3141

# Host Agent probe interval used by the control plane (5..3600 seconds).
MRK_AGENT_CHECK_INTERVAL_SECONDS=60
# mrk-agent process settings (only for the agent itself):
# MRK_AGENT_LISTEN=0.0.0.0:7070
# MRK_AGENT_STATE_DIR=/var/lib/mrk-agent
# MRK_AGENT_DOCKER_SOCKET=/var/run/docker.sock
# MRK_AGENT_HOST_PROC=/host/proc
# MRK_AGENT_HOST_ROOT=/host/root
# MRK_AGENT_PROTECTED_LABEL_PREFIXES=com.dokploy,dokploy
# MRK_AGENT_PROTECTED_COMPOSE_PROJECTS=dokploy
